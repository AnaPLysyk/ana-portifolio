    "@fastify/swagger-ui": "^5.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  }
}
